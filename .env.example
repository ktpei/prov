# Export these in your shell; the CLI does not automatically load .env files.
# Live calls are opt-in. The demo and tests never use credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
# Verify current pricing for your chosen model; no stale rates are embedded.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Only needed for --web; corpus-only live runs do not need Exa.
EXA_API_KEY=
# Conservative maximum charge per search/contents request under your Exa plan.
EXA_MAX_REQUEST_USD=
