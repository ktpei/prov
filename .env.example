# Export in your shell; the CLI does not automatically load .env files.
# Live calls always require --live and an explicit per-run budget.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Conservative maximum published rates checked 2026-11-07; verify before new runs.
# Prices may vary by schedule/provider; these are USD per million tokens.
OPENROUTER_INPUT_USD_PER_MILLION=0.30
OPENROUTER_OUTPUT_USD_PER_MILLION=1.20
# Legacy OpenAI adapter is optional; select it explicitly in the CLI.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Only needed for --web; frozen company-packet research needs no Exa key.
EXA_API_KEY=
EXA_MAX_REQUEST_USD=
